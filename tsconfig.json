{
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "strict": false,
    "typeRoots": [
      "./src/@types",
      "./node_modules/@types"
    ],
    "target": "ES2022",
    "noImplicitAny": true,
    "module": "commonjs"
  },
  "include": [
    "src/**/*.ts"
  ]
}
