DATABASE_URL=postgresql://uppoint:CHANGE_ME@localhost:5432/uppoint_dev
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
HOST=127.0.0.1
PORT=3333
FRONTEND_ORIGINS=http://127.0.0.1:5174,http://localhost:5174
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=
UPLOAD_STORAGE=cloudinary
ENABLE_LEGACY_ROUTES=false
PAGBANK_ENVIRONMENT=sandbox
PAGBANK_TOKEN=
# Public HTTPS URL forwarding to /payments/pagbank/webhook (max 100 characters)
PAGBANK_WEBHOOK_URL=
PAGBANK_FRONTEND_URL=http://127.0.0.1:5174
# Enable only after PagBank grants debit access to your account
PAGBANK_DEBIT_ENABLED=false

# Photon: demo endpoint for local prototyping; configure a dedicated service for production.
PHOTON_API_URL=https://photon.komoot.io/api/
# Open-Meteo: commercial production requires a customer API key.
OPEN_METEO_API_KEY=

# Optional: several listeners in one process, e.g. 3333,3334. CLI --port overrides this.
PORTS=
# Optional public base for uploads; local default uses the request listener port.
PUBLIC_API_URL=

# Comprovantes transacionais: preencher localmente, nunca versionar senhas
FINANCE_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
