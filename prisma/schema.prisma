// This is your Prisma schema file,

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id              String  @id @default(uuid())
  idPlan          String?
  idProduct       String? @unique
  idProductSubscribe String?
  idProfileAvatar String?
  name            String
  companyName     String? 
  email           String?
  password        String
  cpfCnpj         String?
  typePerson      String  @default("PF") // Pode ser "PF" ou "PJ"
  birthDate       String?
  phone           String?
  gender          String?

  complement     String?
  street         String?
  city           String?
  cep            String?
  region_code    String?
  number_address String?
  neighborhood   String?

  typeAccess       String  @default("client")
  profileAvatar    String?
  profileSocialUrl String?

    freeAdUsed Boolean @default(false)
    adOrders AdOrder[]
    tutorialFirstAccess Boolean @default(true)

  registeredBy           String?
  typeAccessRegisteredBy String?
  cpfRegisteredBy        String?
  dateRegisteredBy       String?

  editedBy           String?
  typeAccessEditedBy String?
  cpfEditedBy        String?
  dateEditedBy       String?

  termsUsePlatform   Boolean?
  termsUseLGPD       Boolean?
  termsReceiptNews   Boolean?
  termsPrivacyPolicy Boolean?

  status Boolean @default(true)

  created_At   DateTime  @default(now())
  updated_At   DateTime?
  
  // Relacionamento com planos cadastrados
  plansCreated Plan[] @relation("idUserOwnerPlan")
  planSubscription Plan? @relation("SubscribedPlans", fields: [idPlan], references: [id])

  products  Products[]  
  productSubscription ProductSubscription[] @relation("UserProductSubscription")

  
  typesProducts TypesProducts[]
  purchases     Purchases[]
  events        Events[]
  categories    Categories[]

  commercials     Commercials[]
  typeCommercials TypesCommercials[]

  methodsPayments MethodsPayments[]

  ownedCoupons Coupon[] @relation("UserOwner")
  promoted     Coupon[] @relation("UserPromoter")

  couponUsage CouponUsage[]

  @@map("users")
}

model Products {
  id            String @id @default(uuid())
  idCategory    String
  idTypeProduct String
  idUserOwner   String
  idPlan        String? // <- Adicionado se quiser que produtos pertençam a planos

  name        String
  description String
  labelPrice String
  price      Float

  expirationDate String?
  dateRegistered String

  positionOrder Int?

  available      Boolean  @default(true)
  allowAddCoupon Boolean? @default(false)
  status         Boolean? @default(true)

  created_At DateTime? @default(now())
  updated_At DateTime?

  userOwner     Users?        @relation(fields: [idUserOwner], references: [id])

  typesProducts TypesProducts @relation(fields: [idTypeProduct], references: [id])
  plan          Plan?         @relation("ProductsInPlan", fields: [idPlan], references: [id])

  events        Events[]
  purchases     Purchases[]
  Coupon        Coupon[]
  productSubscriptions ProductSubscription[] 

  @@map("products")
}


model ProductSubscription {
   id            String   @id @default(uuid())
   idUserOwner   String
   idProduct     String
   startDate     DateTime
   endDate       DateTime
   active        Boolean @default(true)
   created_At    DateTime @default(now())
   updated_At    DateTime?

   userOwner     Users    @relation("UserProductSubscription", fields: [idUserOwner], references: [id])
   product       Products @relation(fields: [idProduct], references: [id])

   @@map("product_subscription")
}

model Plan {
  id              String  @id @default(uuid())
  idUserOwnerPlan String
  creditsPlan     Int
  name            String
  description     String?
  price           Float
  duration        Int
  maxEvents       Int?
  maxChars        Int?

  status     Boolean     @default(true)
  created_At DateTime    @default(now())
  updated_At DateTime?

  owner      Users       @relation("idUserOwnerPlan", fields: [idUserOwnerPlan], references: [id])
  purchases  Purchases[]

  usersWhoSubscribed Users[] @relation("SubscribedPlans")

  products Products[] @relation("ProductsInPlan")
  coupon             Coupon[]

  @@map("plans")
}

model Categories {
  id          String @id @default(uuid())
  idUserOwner String

  name          String
  label         String?
  idIcon        String?
  icon          String?
  idThemeImageUrl String?
  themeImageUrl String?

  created_At DateTime  @default(now())
  updated_At DateTime?
  events     Events[]
  userOwner  Users     @relation(fields: [idUserOwner], references: [id])

  @@map("categories")
}

model Commercials {
  id                       String  @id @default(uuid())
  idUserOwner              String
  idTypeCommercial         String
  name                     String
  description              String?
  idUrlImageCommercial     String?
  urlImageCommercial       String
  urlSocialMediaCommercial String?
  positionOrder            Int?

  status           Boolean?         @default(true)
  created_At       DateTime?        @default(now())
  updated_At       DateTime?
  Users            Users            @relation(fields: [idUserOwner], references: [id])
  TypesCommercials TypesCommercials @relation(fields: [idTypeCommercial], references: [id])

  @@map("Commercials")
}

model TypesCommercials {
  id          String @id @default(uuid())
  idUserOwner String
  name        String
  position       String // aqui no value vou colocar o valor da posição left, right, down ou top posição que é onde vai ficar sempre os comerciais. 

  status      Boolean?      @default(true)
  created_At  DateTime?     @default(now())
  updated_At  DateTime?
  Users       Users         @relation(fields: [idUserOwner], references: [id])
  Commercials Commercials[]

  @@map("typesCommercials")
}


model TypesProducts {
  id          String @id @default(uuid())
  idUserOwner String
  name        String
  position    String // aqui no value vou colocar o valor da posição principal, subprincipal, letreiro e outros. 

  status     Boolean?  @default(true)
  created_At DateTime? @default(now())
  updated_At DateTime?

  Users    Users      @relation(fields: [idUserOwner], references: [id])
  products Products[]

  @@map("typesProducts")
}

model Events {
  admissionType String @default("")
  donation String @default("")
  sportCompetition SportCompetition?
  id          String @id @default(uuid())
  idUserOwner String
  idProduct   String?
  idCategory  String

  name          String
  description   String
  localityEvent String

  urlLocalityEvent     String
  urlPostSocialNetwork String? // link do post na rede social mais forte do evento

  bannerImageUrl       String
  dateEvent            String
  hourEvent            String
  placesPurchaseTicket Json? //locais para comprar ingressos
  restrictionsEvent    Json? //restrições do evento
  phoneForContact      String? //global
  status               Boolean @default(true)
  city                 String @default("")
  state                String @default("SC")
  country              String @default("BR")
  priceCents           Int @default(0)
    moderationStatus     String @default("pending")
    moderationReason     String?
    placement            String @default("cards")
    ticketUrl            String @default("")
    streetAddress        String @default("")
    latitude             Float?
    longitude            Float?
    artists              String[] @default([])
    orders               AdOrder[]
    featuredPriority     Int?
  featuredStartsAt     DateTime?
  featuredEndsAt       DateTime?

  products   Products?   @relation(fields: [idProduct], references: [id])
  categories Categories @relation(fields: [idCategory], references: [id])
  userOwner  Users      @relation(fields: [idUserOwner], references: [id])

  created_At DateTime  @default(now())
  updated_At DateTime?

  @@map("events")
}

model Coupon {
  id                 String   @id @default(uuid())
  idUserOwner        String?
  idPromoter         String?
  idProduct          String?
  idPlan             String?
  isMultipleProducts Boolean? @default(false) 
  products           Json?  
  codeCoupon         String
  cpfForUseUnique    String?
  priceDiscount      Float?
  isPercentage       Boolean? @default(false)
  commissionPromoter Float?
  limitUseMax        Int?
  limitCouponUsed    Int?
  status             Boolean  @default(true)
  expirationCoupon   String?

  plan    Plan?     @relation(fields: [idPlan], references: [id])
  product Products? @relation(fields: [idProduct], references: [id])

  user     Users? @relation("UserOwner", fields: [idUserOwner], references: [id], onDelete: Cascade)
  promoter Users? @relation("UserPromoter", fields: [idPromoter], references: [id], onDelete: Cascade)

  created_At DateTime  @default(now())
  updated_At DateTime?

  couponUsage CouponUsage[]

  @@map("coupon")
}

model CouponUsage {
  id                             String   @id @default(uuid())
  idUserOwner                    String
  idCouponUsed                   String
  dateLastPaymentComissionCoupon String?
  statusComissionPaid            Boolean? @default(false)

  coupon Coupon @relation(fields: [idCouponUsed], references: [id])
  user   Users  @relation(fields: [idUserOwner], references: [id])

  created_At DateTime  @default(now())
  updated_At DateTime?

  @@map("couponusage")
}

model MethodsPayments {
  id                String      @id @default(uuid())
  idUserOwner       String
  name              String
  description       String
  typeMethodPayment String
  created_At        DateTime    @default(now())
  updated_At        DateTime?
  purchases         Purchases[]
  Users             Users       @relation(fields: [idUserOwner], references: [id])
  status            Boolean     @default(true)

  @@map("methodspayments")
}

model Purchases {
  id                   String  @id @default(uuid())
  idUser               String
  idMethodPayment      String
  idProduct            String?
  idPlan               String?
  datePayment          String
  codePayment          String
  codeReferencePayment String
  totalPrice           Float
  products             Json
  status               Boolean @default(true)

  created_At DateTime  @default(now())
  updated_At DateTime?

  user            Users           @relation(fields: [idUser], references: [id])
  methodsPayments MethodsPayments @relation(fields: [idMethodPayment], references: [id])
  product         Products?       @relation(fields: [idProduct], references: [id])
  plan            Plan?           @relation(fields: [idPlan], references: [id])

  @@map("purchases")
}

model Bin {
  id         String    @id @default(uuid())
  idUserOwner String?
  tableName  String
  itemId     String
  data       Json
  created_At DateTime  @default(now())
  updated_At DateTime?

  @@map("bin")
}

model PaymentAttempt {
 id String @id @default(uuid())
 orderId String @unique
 method String
 payload Json
 result Json?
 createdAt DateTime @default(now())
}
model PaymentEmail {
 id String @id @default(uuid())
 orderId String
 recipientType String
 recipient String?
 sentAt DateTime?
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now())
 createdAt DateTime @default(now())
 @@unique([orderId, recipientType])
}
model AdOrder {
 billedMonths Int @default(1)
 monthlyRateCents Int @default(0)
 advertisingFrom String @default("")
 advertisingUntil String @default("")
 publicationKey String? @unique
 id String @id @default(uuid())
 userId String
 eventId String @unique
 placement String
 amountCents Int
 status String @default("awaiting_configuration")
   paymentMethod String @default("PAGBANK")
 providerPaymentId String? @unique
   checkoutId String? @unique
   checkoutUrl String?
   checkoutExpiresAt DateTime?
   checkoutPayload Json?
   providerOrderId String?
   paymentEnvironment String?
 paidAt DateTime?
 createdAt DateTime @default(now())
 user Users @relation(fields: [userId], references: [id])
 event Events @relation(fields: [eventId], references: [id])
}
model AdminAudit {
 id String @id @default(uuid())
 actorId String
 action String
 targetId String
 detail String
 createdAt DateTime @default(now())
}
model DailyTraffic {
 day String @id
 pageViews Int @default(0)
}

model SportCompetition {
 sessions SportSession[]
 advertisingFrom String @default("")
 advertisingUntil String @default("")
 billedMonths Int @default(1)
 monthlyRateCents Int @default(0)
 startsOn String @default("")
 endsOn String @default("")
 id String @id @default(uuid())
 eventId String @unique
 sport String
 edition String
 format String
 admissionType String @default("free")
 donation String @default("")
 winPoints Int @default(3)
 drawPoints Int @default(1)
 lossPoints Int @default(0)
 tieBreakers String[] @default(["points", "wins", "goalDifference", "goalsFor"])
 rulesUrl String @default("")
 event Events @relation(fields:[eventId], references:[id], onDelete:Cascade)
 teams SportTeam[]
 rounds SportRound[]
 matches SportMatch[]
}
model SportTeam {
 id String @id @default(uuid())
 competitionId String
 name String
 crestUrl String @default("")
 groupName String @default("")
 pointsAdjustment Int @default(0)
 adjustmentReason String @default("")
 competition SportCompetition @relation(fields:[competitionId],references:[id],onDelete:Cascade)
 players SportPlayer[]
 homeMatches SportMatch[] @relation("HomeTeam")
 awayMatches SportMatch[] @relation("AwayTeam")
 @@unique([competitionId,name])
}
model SportPlayer {
 id String @id @default(uuid())
 teamId String
 name String
 shirt Int
 position String
 team SportTeam @relation(fields:[teamId],references:[id],onDelete:Cascade)
 selections SportSelection[]
 @@unique([teamId,shirt])
}
model SportRound {
 id String @id @default(uuid())
 competitionId String
 number Int
 name String
 competition SportCompetition @relation(fields:[competitionId],references:[id],onDelete:Cascade)
 matches SportMatch[]
 @@unique([competitionId,number])
}
model SportMatch {
 id String @id @default(uuid())
 competitionId String
 roundId String
 homeId String
 awayId String
 date String
 time String
 venue String
 city String
 address String
 latitude Float?
 longitude Float?
 status String @default("scheduled")
 homeScore Int?
 awayScore Int?
 countsForStandings Boolean @default(true)
 admissionType String @default("inherit")
 priceCents Int @default(0)
 donation String @default("")
 homeFormation String @default("")
 awayFormation String @default("")
 officials Json @default("[]")
 officialsConfirmed Boolean @default(false)
 lineupConfirmed Boolean @default(false)
 competition SportCompetition @relation(fields:[competitionId],references:[id],onDelete:Cascade)
 round SportRound @relation(fields:[roundId],references:[id],onDelete:Cascade)
 home SportTeam @relation("HomeTeam",fields:[homeId],references:[id])
 away SportTeam @relation("AwayTeam",fields:[awayId],references:[id])
 selections SportSelection[]
 @@index([competitionId,date,time])
}
model SportSelection {
 matchId String
 playerId String
 starter Boolean @default(true)
 position String
 match SportMatch @relation(fields:[matchId],references:[id],onDelete:Cascade)
 player SportPlayer @relation(fields:[playerId],references:[id],onDelete:Cascade)
 @@id([matchId,playerId])
}
model SportSession {
 officialsConfirmed Boolean @default(false)
 latitude Float?
 longitude Float?
 id String @id @default(uuid())
 competitionId String
 title String
 category String @default("")
 date String
 time String
 venue String
 city String
 address String
 details Json @default("{}")
 officials Json @default("[]")
 status String @default("scheduled")
 competition SportCompetition @relation(fields:[competitionId],references:[id],onDelete:Cascade)
 @@index([competitionId,date,time])
}
