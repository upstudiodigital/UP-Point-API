{
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@types/cors": "^2.8.16",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/nodemailer": "^7.0.12",
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-fileupload": "^1.5.1",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.5.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "tsup": "^8.2.4",
    "uuid": "^11.0.5"
  },
  "scripts": {
    "dev": "tsx scripts/dev-local.ts",
    "build": "npm run typecheck && tsup",
    "start": "node dist/server.js",
    "run-build": "npx prisma migrate deploy",
    "vercel-build": "npm run prisma:generate && npm run build",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.portal.json",
    "test": "tsx --test tests/*.test.ts",
    "seed:dev": "tsx scripts/seed-development.ts",
    "backup": "tsx scripts/backup.ts",
    "preflight:production": "tsx scripts/preflight-production.ts",
    "receipts:deliver": "tsx scripts/deliver-receipts.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include=\"src/**\" --test tests/*.test.ts",
    "qa:http": "tsx scripts/qa-http.ts"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.4.2",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.5",
    "prisma": "^6.9.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2"
  }
